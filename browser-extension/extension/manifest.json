{
  "manifest_version": 3,
  "name": "Open in OK Player",
  "version": "1.0.0",
  "description": "Open a video link, video source, or page in the installed OK Player.",
  "key": "",
  "permissions": [
    "activeTab",
    "contextMenus",
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open current page in OK Player"
  }
}

<?xml version="1.0" encoding="utf-8"?>
<!-- Raw theme-invariant Color seeds for gradients and code-behind that need a raw Color. The app's colour
     family (accent, surfaces, text, status) is not here: it comes from brand/palette.json at the repository
     root, embedded into OkPlayer.Core and applied to the themed brushes at startup (AccentManager). -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Over-video constants (same in both themes — the video beneath is theme-agnostic) -->
    <Color x:Key="OkOverVideoFillColor">#80161619</Color>
    <Color x:Key="OkOverVideoToastColor">#99161619</Color>
    <Color x:Key="OkScrimColor">#6B000000</Color>

</ResourceDictionary>

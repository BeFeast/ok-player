  "plan_cases": [
    {"name": "idle: open plays with its start", "input": "ok-player://open?url=https%3A%2F%2Fcam.example%2Fclips%2FA001.MP4&t=90", "current": null, "plan": {"open": {"url": "https://cam.example/clips/A001.MP4", "start": 90}}, "presents": true},
    {"name": "idle: add acts as open, start included", "input": "ok-player://add?path=%2Fmedia%2Fa.mkv&t=30", "fs": "file", "current": null, "plan": {"open": {"path": "/media/a.mkv", "start": 30}}, "presents": true},
    {"name": "idle: next acts as open", "input": "ok-player://next?path=%2Fmedia%2Fa.mkv", "fs": "file", "current": null, "plan": {"open": {"path": "/media/a.mkv"}}, "presents": true},
    {"name": "playing: add appends without raising", "input": "ok-player://add?path=%2Fmedia%2Fa.mkv", "fs": "file", "current": {"path": "/media/b.mkv"}, "plan": {"queue": {"path": "/media/a.mkv", "mode": "append"}}, "presents": false},
    {"name": "playing: t on add is ignored with a notice", "input": "ok-player://add?url=https%3A%2F%2Fcam.example%2Fclips%2FA001.MP4&t=30", "current": {"path": "/media/b.mkv"}, "plan": {"queue": {"url": "https://cam.example/clips/A001.MP4", "mode": "append", "start_ignored": true}}, "presents": false},
    {"name": "playing: next inserts after the current item", "input": "ok-player://next?path=%2Fmedia%2Fa.mkv", "fs": "file", "current": {"path": "/media/b.mkv"}, "plan": {"queue": {"path": "/media/a.mkv", "mode": "after_current"}}, "presents": false},
    {"name": "playing: open of another file replaces it", "input": "ok-player://open?path=%2Fmedia%2Fa.mkv&t=12", "fs": "file", "current": {"path": "/media/b.mkv"}, "plan": {"open": {"path": "/media/a.mkv", "start": 12}}, "presents": true},
    {"name": "playing: open of the current file with t seeks", "input": "ok-player://open?path=%2Fmedia%2Fa.mkv&t=12", "fs": "file", "current": {"path": "/media/a.mkv"}, "plan": {"seek": {"start": 12}}, "presents": true},
    {"name": "playing: open of the current file without t reopens", "input": "ok-player://open?path=%2Fmedia%2Fa.mkv", "fs": "file", "current": {"path": "/media/a.mkv"}, "plan": {"open": {"path": "/media/a.mkv"}}, "presents": true},
    {"name": "playing: open of the current file with a dropped t reopens", "input": "ok-player://open?path=%2Fmedia%2Fa.mkv&t=x", "fs": "file", "current": {"path": "/media/a.mkv"}, "plan": {"open": {"path": "/media/a.mkv"}}, "presents": true},
    {"name": "playing: open of the current URL with t seeks", "input": "ok-player://open?url=https%3A%2F%2Fcam.example%2Fclips%2FA001.MP4&t=7", "current": {"url": "https://cam.example/clips/A001.MP4"}, "plan": {"seek": {"start": 7}}, "presents": true},
    {"name": "playing: a file URL naming the current path seeks", "input": "ok-player://open?url=file%3A%2F%2F%2Fmedia%2Fa.mkv&resume=3", "fs": "file", "current": {"path": "/media/a.mkv"}, "plan": {"seek": {"start": 3}}, "presents": true}

{
  "about": "Shared cases for the ok-player:// v1 link contract (epic #845). Each case runs interpret, then evaluate with a fake filesystem probe that answers fs for any path (a case without fs fails if the probe is asked anything), then plan or launch_shape. Paths that are not UTF-8 are given as path_hex. {fill} in input and expect is replaced with a run of a so that input is fill_to_length bytes long.",
  "cases": [
    {"name": "open a URL encoded with encodeURIComponent", "input": "ok-player://open?url=https%3A%2F%2Fcam.example%2Fclips%2FA001.MP4", "expect": {"result": "accept", "action": "open", "url": "https://cam.example/clips/A001.MP4"}},
    {"name": "the URL keeps its own query and port; t in seconds", "input": "ok-player://open?url=https%3A%2F%2Fcam.example%3A8080%2Fc.mp4%3Ftoken%3Da%26b%3Dc&t=90", "expect": {"result": "accept", "action": "open", "url": "https://cam.example:8080/c.mp4?token=a&b=c", "start": 90}},
    {"name": "add a URL", "input": "ok-player://add?url=https%3A%2F%2Fcam.example%2Fclips%2FA001.MP4", "expect": {"result": "accept", "action": "add", "url": "https://cam.example/clips/A001.MP4"}},
    {"name": "next a URL", "input": "ok-player://next?url=https%3A%2F%2Fcam.example%2Fclips%2FA001.MP4", "expect": {"result": "accept", "action": "next", "url": "https://cam.example/clips/A001.MP4"}},
    {"name": "the action is case-insensitive", "input": "ok-player://OPEN?url=https%3A%2F%2Fcam.example%2Fclips%2FA001.MP4", "expect": {"result": "accept", "action": "open", "url": "https://cam.example/clips/A001.MP4"}},
    {"name": "the scheme is case-insensitive", "input": "OK-Player://open?url=https%3A%2F%2Fcam.example%2Fclips%2FA001.MP4", "expect": {"result": "accept", "action": "open", "url": "https://cam.example/clips/A001.MP4"}},
    {"name": "opaque form", "input": "ok-player:add?url=https%3A%2F%2Fcam.example%2Fclips%2FA001.MP4", "expect": {"result": "accept", "action": "add", "url": "https://cam.example/clips/A001.MP4"}},
    {"name": "path= target", "input": "ok-player://open?path=%2Fmedia%2Fclips%2Fa%20b.mkv", "fs": "file", "expect": {"result": "accept", "action": "open", "path": "/media/clips/a b.mkv"}},
    {"name": "path form", "input": "ok-player://open/media/clips/a%20b.mkv", "fs": "file", "expect": {"result": "accept", "action": "open", "path": "/media/clips/a b.mkv"}},
    {"name": "path form with t as m:ss", "input": "ok-player://next/media/a.mkv?t=1:30", "fs": "file", "expect": {"result": "accept", "action": "next", "path": "/media/a.mkv", "start": 90}},
    {"name": "open/ with url= reads like open?url=", "input": "ok-player://open/?url=https%3A%2F%2Fcam.example%2Fclips%2FA001.MP4", "expect": {"result": "accept", "action": "open", "url": "https://cam.example/clips/A001.MP4"}},
    {"name": "file URL with an empty host becomes a path", "input": "ok-player://open?url=file%3A%2F%2F%2Fmedia%2Fa%2520b.mkv", "fs": "file", "expect": {"result": "accept", "action": "open", "path": "/media/a b.mkv"}},
    {"name": "file URL with localhost becomes a path", "input": "ok-player://open?url=file%3A%2F%2Flocalhost%2Fmedia%2Fa.mkv", "fs": "file", "expect": {"result": "accept", "action": "open", "path": "/media/a.mkv"}},
    {"name": "t with a fraction", "input": "ok-player://open?url=https%3A%2F%2Fcam.example%2Fclips%2FA001.MP4&t=90.5", "expect": {"result": "accept", "action": "open", "url": "https://cam.example/clips/A001.MP4", "start": 90.5}},
    {"name": "t as h:mm:ss", "input": "ok-player://open?url=https%3A%2F%2Fcam.example%2Fclips%2FA001.MP4&t=1:02:03", "expect": {"result": "accept", "action": "open", "url": "https://cam.example/clips/A001.MP4", "start": 3723}},
    {"name": "resume is an alias of t", "input": "ok-player://open?url=https%3A%2F%2Fcam.example%2Fclips%2FA001.MP4&resume=75", "expect": {"result": "accept", "action": "open", "url": "https://cam.example/clips/A001.MP4", "start": 75}},
    {"name": "t of zero", "input": "ok-player://open?url=https%3A%2F%2Fcam.example%2Fclips%2FA001.MP4&t=0", "expect": {"result": "accept", "action": "open", "url": "https://cam.example/clips/A001.MP4", "start": 0}},
    {"name": "malformed t is dropped with a notice", "input": "ok-player://open?url=https%3A%2F%2Fcam.example%2Fclips%2FA001.MP4&t=abc", "expect": {"result": "accept", "action": "open", "url": "https://cam.example/clips/A001.MP4", "start_dropped": true}},
    {"name": "empty t is dropped", "input": "ok-player://open?url=https%3A%2F%2Fcam.example%2Fclips%2FA001.MP4&t=", "expect": {"result": "accept", "action": "open", "url": "https://cam.example/clips/A001.MP4", "start_dropped": true}},
    {"name": "negative t is dropped", "input": "ok-player://open?url=https%3A%2F%2Fcam.example%2Fclips%2FA001.MP4&t=-5", "expect": {"result": "accept", "action": "open", "url": "https://cam.example/clips/A001.MP4", "start_dropped": true}},
    {"name": "t with four fields is dropped", "input": "ok-player://open?url=https%3A%2F%2Fcam.example%2Fclips%2FA001.MP4&t=1:2:3:4", "expect": {"result": "accept", "action": "open", "url": "https://cam.example/clips/A001.MP4", "start_dropped": true}},
    {"name": "non-UTF-8 t is dropped", "input": "ok-player://open?url=https%3A%2F%2Fcam.example%2Fclips%2FA001.MP4&t=%FF", "expect": {"result": "accept", "action": "open", "url": "https://cam.example/clips/A001.MP4", "start_dropped": true}},
    {"name": "unknown keys are ignored and never forwarded", "input": "ok-player://open?url=https%3A%2F%2Fcam.example%2Fclips%2FA001.MP4&autoplay=1&mpv-options=--script%3Devil.lua", "expect": {"result": "accept", "action": "open", "url": "https://cam.example/clips/A001.MP4", "ignored_keys": ["autoplay", "mpv-options"]}},
    {"name": "empty query pairs are skipped", "input": "ok-player://open?&url=https%3A%2F%2Fcam.example%2Fclips%2FA001.MP4&&t=5&", "expect": {"result": "accept", "action": "open", "url": "https://cam.example/clips/A001.MP4", "start": 5}},
    {"name": "an empty fragment is allowed", "input": "ok-player://open?url=https%3A%2F%2Fcam.example%2Fclips%2FA001.MP4#", "expect": {"result": "accept", "action": "open", "url": "https://cam.example/clips/A001.MP4"}},
    {"name": "%252F stays the literal %2F in a path", "input": "ok-player://open?path=%2Fmedia%2F100%252Fclip.mkv", "fs": "file", "expect": {"result": "accept", "action": "open", "path": "/media/100%2Fclip.mkv"}},
    {"name": "%252F stays the literal %2F in a URL", "input": "ok-player://open?url=https%3A%2F%2Fcam.example%2Fa%252Fb.mp4", "expect": {"result": "accept", "action": "open", "url": "https://cam.example/a%2Fb.mp4"}},
    {"name": "+ is a space in a query value", "input": "ok-player://open?path=%2Fmedia%2Fa+b.mkv", "fs": "file", "expect": {"result": "accept", "action": "open", "path": "/media/a b.mkv"}},
    {"name": "%2B is a plus in a query value", "input": "ok-player://open?path=%2Fmedia%2Fa%2Bb.mkv", "fs": "file", "expect": {"result": "accept", "action": "open", "path": "/media/a+b.mkv"}},
    {"name": "+ is literal in the path form", "input": "ok-player://open/media/a+b.mkv", "fs": "file", "expect": {"result": "accept", "action": "open", "path": "/media/a+b.mkv"}},
    {"name": "%2B is a plus inside url=", "input": "ok-player://open?url=https%3A%2F%2Fcam.example%2Fa%2Bb.mp4", "expect": {"result": "accept", "action": "open", "url": "https://cam.example/a+b.mp4"}},
    {"name": "non-UTF-8 path= on POSIX keeps raw bytes", "input": "ok-player://open?path=%2Fmedia%2F%FF.mkv", "fs": "file", "expect": {"result": "accept", "action": "open", "path_hex": "2f6d656469612fff2e6d6b76"}},
    {"name": "non-UTF-8 path form on POSIX keeps raw bytes", "input": "ok-player://open/media/%FF.mkv", "fs": "file", "expect": {"result": "accept", "action": "open", "path_hex": "2f6d656469612fff2e6d6b76"}},
    {"name": "UTF-8 path", "input": "ok-player://open?path=%2Fmedia%2Fcaf%C3%A9.mkv", "fs": "file", "expect": {"result": "accept", "action": "open", "path": "/media/café.mkv"}},
    {"name": "raw non-ASCII in the path form is taken as UTF-8", "input": "ok-player://open/media/café.mkv", "fs": "file", "expect": {"result": "accept", "action": "open", "path": "/media/café.mkv"}},
    {"name": "IPv6 host with a port", "input": "ok-player://open?url=http%3A%2F%2F%5B2001%3Adb8%3A%3A1%5D%3A8080%2Fa.mp4", "expect": {"result": "accept", "action": "open", "url": "http://[2001:db8::1]:8080/a.mp4"}},
    {"name": "cap: exactly 4096 bytes is accepted", "input": "ok-player://open?url=https%3A%2F%2Fh.example%2F{fill}.mp4", "fill_to_length": 4096, "expect": {"result": "accept", "action": "open", "url": "https://h.example/{fill}.mp4"}},
    {"name": "Windows: drive-absolute path", "input": "ok-player://open?path=C%3A%5Cmedia%5Cclip.mkv", "flavor": "windows", "fs": "file", "expect": {"result": "accept", "action": "open", "path": "C:\\media\\clip.mkv"}},
    {"name": "Windows: local file URL becomes a drive path", "input": "ok-player://open?url=file%3A%2F%2F%2FC%3A%2Fmedia%2Fclip.mkv", "flavor": "windows", "fs": "file", "expect": {"result": "accept", "action": "open", "path": "C:\\media\\clip.mkv"}},
    {"name": "Windows: http URL", "input": "ok-player://open?url=https%3A%2F%2Fcam.example%2Fclips%2FA001.MP4", "flavor": "windows", "expect": {"result": "accept", "action": "open", "url": "https://cam.example/clips/A001.MP4"}},
    {"name": "not ours: 'https://cam.example/a.mp4'", "input": "https://cam.example/a.mp4", "expect": {"result": "not_ours"}},
    {"name": "not ours: '/media/a.mkv'", "input": "/media/a.mkv", "expect": {"result": "not_ours"}},
    {"name": "not ours: 'okplayer://open?url=x'", "input": "okplayer://open?url=x", "expect": {"result": "not_ours"}},
    {"name": "not ours: 'file:///media/a.mkv'", "input": "file:///media/a.mkv", "expect": {"result": "not_ours"}},
    {"name": "not ours: ''", "input": "", "expect": {"result": "not_ours"}},
    {"name": "not ours: 'ok-player'", "input": "ok-player", "expect": {"result": "not_ours"}},
    {"name": "not ours: 'xok-player://open'", "input": "xok-player://open", "expect": {"result": "not_ours"}},
    {"name": "not ours: 'smb://nas/a.mkv'", "input": "smb://nas/a.mkv", "expect": {"result": "not_ours"}},
    {"name": "unsupported action: play", "input": "ok-player://play?id=42", "expect": {"result": "unsupported", "action": "play"}},
    {"name": "unsupported action is lowercased", "input": "ok-player://PAUSE", "expect": {"result": "unsupported", "action": "pause"}},
    {"name": "unsupported action: seek", "input": "ok-player://seek?t=10", "expect": {"result": "unsupported", "action": "seek"}},
    {"name": "cap: 4097 bytes is too long", "input": "ok-player://open?url=https%3A%2F%2Fh.example%2F{fill}.mp4", "fill_to_length": 4097, "expect": {"result": "reject", "action": null, "reason": "too_long"}},
    {"name": "raw whitespace", "input": "ok-player://open?url=a b", "expect": {"result": "reject", "action": null, "reason": "invalid_character"}},
    {"name": "raw control character", "input": "ok-player://open?url=https://h.example/a\u0007.mp4", "expect": {"result": "reject", "action": null, "reason": "invalid_character"}},
    {"name": "non-empty fragment", "input": "ok-player://open?url=https%3A%2F%2Fcam.example%2Fclips%2FA001.MP4#t=5", "expect": {"result": "reject", "action": null, "reason": "fragment"}},
    {"name": "an unencoded # inside url= is a fragment", "input": "ok-player://open?url=https://cam.example/a.mp4#x", "expect": {"result": "reject", "action": null, "reason": "fragment"}},
    {"name": "userinfo", "input": "ok-player://user@open?url=https%3A%2F%2Fcam.example%2Fclips%2FA001.MP4", "expect": {"result": "reject", "action": null, "reason": "userinfo"}},
    {"name": "userinfo with a password", "input": "ok-player://user:pw@open?url=https%3A%2F%2Fcam.example%2Fclips%2FA001.MP4", "expect": {"result": "reject", "action": null, "reason": "userinfo"}},
    {"name": "port", "input": "ok-player://open:8080?url=https%3A%2F%2Fcam.example%2Fclips%2FA001.MP4", "expect": {"result": "reject", "action": null, "reason": "port"}},
    {"name": "a drive letter in the authority is a port", "input": "ok-player://C:/media/a.mkv", "expect": {"result": "reject", "action": null, "reason": "port"}},
    {"name": "no action", "input": "ok-player://", "expect": {"result": "reject", "action": null, "reason": "missing_action"}},
    {"name": "opaque form without action", "input": "ok-player:", "expect": {"result": "reject", "action": null, "reason": "missing_action"}},
    {"name": "empty authority", "input": "ok-player:///open?url=https%3A%2F%2Fcam.example%2Fclips%2FA001.MP4", "expect": {"result": "reject", "action": null, "reason": "missing_action"}},
    {"name": "query without action", "input": "ok-player://?url=https%3A%2F%2Fcam.example%2Fclips%2FA001.MP4", "expect": {"result": "reject", "action": null, "reason": "missing_action"}},
    {"name": "percent-encoded action", "input": "ok-player://op%65n?url=https%3A%2F%2Fcam.example%2Fclips%2FA001.MP4", "expect": {"result": "reject", "action": null, "reason": "invalid_action"}},
    {"name": "bracketed action", "input": "ok-player://[open]?url=https%3A%2F%2Fcam.example%2Fclips%2FA001.MP4", "expect": {"result": "reject", "action": null, "reason": "invalid_action"}},
    {"name": "%G1 in url=", "input": "ok-player://open?url=https%3A%2F%2Fcam.example%2Fa%G1.mp4", "expect": {"result": "reject", "action": "open", "reason": "bad_percent_encoding"}},
    {"name": "truncated percent escape", "input": "ok-player://open?url=https%3A%2F%2Fcam.example%2Fa.mp4%2", "expect": {"result": "reject", "action": "open", "reason": "bad_percent_encoding"}},
    {"name": "bad percent in an ignored value still rejects", "input": "ok-player://add?url=https%3A%2F%2Fcam.example%2Fclips%2FA001.MP4&x=%ZZ", "expect": {"result": "reject", "action": "add", "reason": "bad_percent_encoding"}},
    {"name": "bad percent in a key", "input": "ok-player://open?url=https%3A%2F%2Fcam.example%2Fclips%2FA001.MP4&%ZZ=1", "expect": {"result": "reject", "action": "open", "reason": "bad_percent_encoding"}},
    {"name": "bad percent in the path form", "input": "ok-player://open/media/a%G1.mkv", "expect": {"result": "reject", "action": "open", "reason": "bad_percent_encoding"}},
    {"name": "bad percent inside a file URL path", "input": "ok-player://open?url=file%3A%2F%2F%2Fmedia%2Fa%25G1.mkv", "expect": {"result": "reject", "action": "open", "reason": "bad_percent_encoding"}},
    {"name": "a URL nested in the path form", "input": "ok-player://open/https://cam.example/a.mp4", "expect": {"result": "reject", "action": "open", "reason": "nested_url"}},
    {"name": "an encoded URL nested in the path form", "input": "ok-player://open/https%3A%2F%2Fcam.example%2Fa.mp4", "expect": {"result": "reject", "action": "open", "reason": "nested_url"}},
    {"name": "an mpv protocol nested in the path form", "input": "ok-player://open/edl://a.mkv", "expect": {"result": "reject", "action": "open", "reason": "nested_url"}},
    {"name": "a nested ok-player link in the path form", "input": "ok-player://next/ok-player://open?url=https%3A%2F%2Fcam.example%2Fclips%2FA001.MP4", "expect": {"result": "reject", "action": "next", "reason": "nested_url"}},
    {"name": "duplicate url", "input": "ok-player://open?url=https%3A%2F%2Fcam.example%2Fclips%2FA001.MP4&url=https%3A%2F%2Fcam.example%2Fclips%2FA001.MP4", "expect": {"result": "reject", "action": "open", "reason": "duplicate_key"}},
    {"name": "t and resume together", "input": "ok-player://open?url=https%3A%2F%2Fcam.example%2Fclips%2FA001.MP4&t=1&resume=2", "expect": {"result": "reject", "action": "open", "reason": "duplicate_key"}},
    {"name": "duplicate t", "input": "ok-player://open?url=https%3A%2F%2Fcam.example%2Fclips%2FA001.MP4&t=1&t=2", "expect": {"result": "reject", "action": "open", "reason": "duplicate_key"}},
    {"name": "duplicate unknown key", "input": "ok-player://open?url=https%3A%2F%2Fcam.example%2Fclips%2FA001.MP4&foo=1&foo=2", "expect": {"result": "reject", "action": "open", "reason": "duplicate_key"}},
    {"name": "url and path together", "input": "ok-player://open?url=https%3A%2F%2Fcam.example%2Fclips%2FA001.MP4&path=%2Fmedia%2Fa.mkv", "expect": {"result": "reject", "action": "open", "reason": "multiple_targets"}},
    {"name": "path form and url together", "input": "ok-player://open/media/a.mkv?url=https%3A%2F%2Fcam.example%2Fclips%2FA001.MP4", "expect": {"result": "reject", "action": "open", "reason": "multiple_targets"}},
    {"name": "path form and path together", "input": "ok-player://add/media/a.mkv?path=%2Fmedia%2Fb.mkv", "expect": {"result": "reject", "action": "add", "reason": "multiple_targets"}},
    {"name": "no target", "input": "ok-player://open", "expect": {"result": "reject", "action": "open", "reason": "missing_target"}},
    {"name": "open/ is not a target", "input": "ok-player://open/", "expect": {"result": "reject", "action": "open", "reason": "missing_target"}},
    {"name": "open/ with an empty url=", "input": "ok-player://open/?url=", "expect": {"result": "reject", "action": "open", "reason": "missing_target"}},
    {"name": "t without a target", "input": "ok-player://open?t=5", "expect": {"result": "reject", "action": "open", "reason": "missing_target"}},
    {"name": "empty path=", "input": "ok-player://open?path=", "expect": {"result": "reject", "action": "open", "reason": "missing_target"}},
    {"name": "url without =", "input": "ok-player://open?url", "expect": {"result": "reject", "action": "open", "reason": "missing_target"}},
    {"name": "opaque form without a target", "input": "ok-player:add", "expect": {"result": "reject", "action": "add", "reason": "missing_target"}},
    {"name": "non-UTF-8 url= (POSIX)", "input": "ok-player://open?url=%FF", "expect": {"result": "reject", "action": "open", "reason": "non_utf8_url"}},
    {"name": "non-UTF-8 url= (Windows)", "input": "ok-player://open?url=%FF", "flavor": "windows", "expect": {"result": "reject", "action": "open", "reason": "non_utf8_url"}},

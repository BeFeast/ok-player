    {"name": "file and a link", "args": ["/media/b.mkv", "ok-player://open?url=https%3A%2F%2Fcam.example%2Fclips%2FA001.MP4"], "expect": {"result": "reject", "reason": "launch_shape"}},
    {"name": "switch and a link", "args": ["--fullscreen", "ok-player://open?url=https%3A%2F%2Fcam.example%2Fclips%2FA001.MP4"], "expect": {"result": "reject", "reason": "launch_shape"}},
